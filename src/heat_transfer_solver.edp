cout << "   ------ Time iterations start here ------     " << endl;

// Declare variables for the time loop
int EnerIdent=0;



string sIdentifier;

real maxErrT;
real maxErrTOld;
real cpu=clock();
real bStopIter = false;


real uTInlet, uTOutlet, avgOfOut;
real avgOf, avgOs;

uTInlet = (1./H)*int1d(Th,Inlet)(u*Of);
uTOutlet = (1./H)*int1d(Th,Outlet)(u*Of);
avgOf = int2d(Th)(Of)/Th.area;
avgOs = int2d(Th)(Os)/Th.area;
cout << " Inlet u*Tf = " << uTInlet << " Outlet u*Tf = " << uTOutlet << " Avg Fluid T = " << avgOf << " Avg Solid T = " << avgOs << endl;


// for(i=istart; i< iend; i++){
	// Update relevant variables
	i=12;
	qa = aAbsRad[i];
	Ta = aAmbTemp[i];
	Ts = aSkyTemp[i];
	hw = aWindCoef[i];

	sTimeF = aFormTime[i];

	// Reset identifier used for temperature fields
	EnerIdent = 0;

	// filelog << " Array position number i = " << i << " - Time hhmm = " << sTimeF << " - Absorbed radiation = " << qa << " W/m^2" << endl;

	for(n = 0; n < 15e3; n++){
		// ENERGY CONSERVATION PROBLEM
		// ------ Update fields ------
		Ofold = Of;
		Osold = Os;

		// Get plate temperature
		Tp = (1/L)*int1d(Th,TopWall)(fphi*Of+(1-fphi)*Os);
		cout << " Average plate temperature is " << Tp << " degK " << endl;

		// Calculate top heat loss coefficient
		Ut = TopHeatLoss(Ta, Ts, Tp, hw, beta);
		cout << " Top heat loss coefficient is " << Ut << " W/(m^2-degK) " << endl;
		
		
		// Reconstruct RHS vectors
		bEnerF = EnergyFluid(0,Vh);
		bEnerS = EnergySolid(0,Vh);
		
		// Solve coupled energy problem
		solEnerF[] = AEnerF^-1 * bEnerF;
		solEnerS[] = AEnerS^-1 * bEnerS;

		Of = solEnerF;
		Os = solEnerS;

		Ofaux =Of-aAmbTemp[0];

		// Errors		
		errf = sqrt(int2d(Th)(square(Of-Ofold))/Th.area);
		errs = sqrt(int2d(Th)(square(Os-Osold))/Th.area);
		maxErrT = fmax(errf, errs);

		uTInlet = (1./H)*int1d(Th,Inlet)(u*Ofaux);
		uTOutlet = (1./H)*int1d(Th,Outlet)(u*Ofaux);
		// avgOf = int2d(Th)(Of)/Th.area;
		// avgOs = int2d(Th)(Os)/Th.area;

		avgOfOut = (1./H)*int1d(Th,Outlet)(Of);

		// cout << "iter = " << n << " Fluid L2 = " << errf << " Solid L2 = " << errs << " Inlet u*Tf = " << uTInlet << " Outlet u*Tf = " << uTOutlet  << " Avg Fluid T = " << avgOf << " Avg Solid T = " << avgOs << endl;
		cout << "iter = " << n << " Fluid L2 = " << errf << " Solid L2 = " << errs << " Inlet u*Tf = " << uTInlet << " Outlet u*Tf = " << uTOutlet  << " Avg Outlet Fluid T = " << avgOfOut << endl;
		
		if(n % 25 == 0){
			if(n % 100 == 0){
				if(bExportData){
					sIdentifier = ThreeDigitInteger(EnerIdent);
					sTextTempF = sVelAddressTXT + sTempFluid + "_" + sTimeF + "_" + sIdentifier + sTextFormat;
					sTextTempS = sVelAddressTXT + sTempSolid + "_" + sTimeF + "_" + sIdentifier + sTextFormat;

					sVTUTempF = sVelAddressVTU + sTempFluid + "_" + sTimeF + "_" + sIdentifier + sVTUFormat;
					sVTUTempS = sVelAddressVTU + sTempSolid + "_" + sTimeF + "_" + sIdentifier + sVTUFormat;

					ofstream FluidTempdata(sTextTempF);
					ofstream SolidTempdata(sTextTempS);

					FluidTempdata << Of[] << endl;
					SolidTempdata << Os[] << endl;

					savevtk(sVTUTempF, Th, Of, order=OrderOut);
					savevtk(sVTUTempS, Th, Os, order=OrderOut);

					EnerIdent += 1;
				}
				logfile << "iter = " << n << " Fluid L2 = " << errf << " Solid L2 = " << errs << " Inlet u*Tf = " << uTInlet << " Outlet u*Tf = " << uTOutlet  << " Avg Outlet Fluid T = " << avgOfOut << endl;
				plot(Of, wait=false, fill=true, cmm="Fluid temperature");
			}
			if(n % 250 == 0){
				if(n > 0){
					if(((maxErrTOld-maxErrT) < 0) && (maxErrT > 1)){
						bStopIter = true;
						break;
					}
				}
				maxErrTOld = maxErrT;
			}
			if(maxErrT < 7.5e-9) {
				// filelog << "iter = " << n << " Fluid L2 = " << errf << " Solid L2 = " << errs << " Inlet u*Tf = " << uTInlet << " Outlet u*Tf = " << uTOutlet  << " Avg Outlet Fluid T = " << avgOfOut << endl;
				break;
			}
		}

	}

	// if(bStopIter){
	// 	cout << " Current iterations diverges when t is " << sTimeF << endl;
	// 	break;
	// }

// }

plot(Os, wait=true, fill=true, cmm="Solid temperature");
plot(Of, wait=true, fill=true, cmm="Fluid temperature");