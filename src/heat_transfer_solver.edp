// ------ P O R O U S    M E D I A    P R O P E R T I E S ------ //


// Porosity as a QUADRATIC function of "y"
// Input
// real yw = 0.;	// location of wall on y-axis
// real yc = 0.0125; 	// location of maximum or minimum in quadratic function
// real phiw = 0.97; 	// porosity on lower wall
// real phic = 0.8; 	// porosity on center

// // ------ Proposed porosity scalar field ------
// func fphi = ((phiw-phic)/(square(yw-yc)))*((y-yc)^2.)+phic;

// Porosity as a LINEAR function of "y"
// Input
real phiw1 = 0.97; 	// porosity at lower wall
real phiw2 = 0.83; 	// porosity at upper wall
real y1 = 0.;	// location of lower wall on y-axis
real y2 = H;	// location of upper wall on y-axis

// ------ Proposed porosity scalar field ------
func fphi = ((phiw2-phiw1)/(y2-y1))*(y-y1)+phiw1; // in m/m


// Pore size as a linear function of the porosity "phi"
// Input
real dp1 = 0.0028; 	// known average pore size 1
real dp2 = 0.0025; 	// known average pore size 2
real phi1 = 0.85; 	// know porosity 1
real phi2 = 0.95; 	// know porosity 2

// ------ Proposed pore size scalar field ------
func fdp = ((dp2-dp1)/(phi2-phi1))*(fphi-phi1)+dp1; // in m



// ------ Filament size ------
func fdf = 1.18*fdp*sqrt((1.-fphi)/(3*pi))/(1-exp((fphi-1.)/0.04));  // in m



// ------ Tortuosity ------

// Du Plesis et al (1994) model
func Tor = 1./((3./(4*fphi))+((sqrt(9.-8.*fphi))/(2.*fphi))*cos((4*pi/3.)+(1./3)*acos((8.*square(fphi)-36.*fphi+27.)/(((9.-8.*fphi)^(3./2)))))); // in m/m



// ------ Cell size ------

// Du Plesis et al (1994) model
func dc = sqrt(Tor/(3.*fphi))*fdp;  // in m



// ------ Specific interfacial area ------

// Du Plesis et al (1994) model
func asf = (3./dc)*(3.-Tor)*(Tor-1.); // in m^2/m^3



// ------ Permeability ------

// Calmidi (1998) model
func rfip=1.18*sqrt((1-fphi)/(3*pi))/(1-exp((fphi-1.)/0.04)); 		// filament to pore size ratio, in m/m
func fK=0.00073*(fdp^2)*((1-fphi)^(-0.224))*(rfip^(-1.11)); 		// in m^2

// Du Plesis et al (1994)
//~ func K = square(phi*dc)/(36.*Tor*(3.-Tor));		// in m^2



// ------ Forchheimer coefficient ------

// Calmidi (1998) model
func cF=0.00212*((1-fphi)^(-0.132))*(rfip^(-1.63)); 		// non-dimensional

// Du Plesis et al (1994)
//~ func cF = 2.05*Tor*(Tor-1)*sqrt(K)/(square(phi)*(3.-Tor)*dc);



// ------ T H E R M O P H Y S I C A L    P R O P E R T I E S ------ //

// Constants
real g=9.807;					// Earth's gravity, in m/s^2
real sigma=5.670374419e-8;		// Stefan-Boltzmann constant, in  W/(m^2-K^4)

// Emisivities
real emisC=0.92;					// glass cover emissivity
real emisP=0.98;					// collector plate emissivity

// Fluid phase properties: water
// Properties at 25°C and 1 atm of atmosferic pressure
real rhof = 997.05; 		// density in kg/m^3
real mu = 8.891e-4;			// dynamic viscosity in Pa/s or N-s/m^2
real nu = 8.971e-7;			// kinematic viscosity in m^2/s
real cpf = 4180.;		 	// specific heat in J/(kg-°K)
real kf = 0.606;		 	// thermal conductivity in W/(m-°K)
real alphaf = 0.1454e-6;	// thermal diffisivity in m^2/s
real Pr=6.17;				// Prandtl number (non-dimensional)

// Solid phase properties: aluminum
// Properties at 25°C and 1 atm of atmosferic pressure
real rhos = 2701.;		// density in kg/m^3
real cps = 902.;		// specific heat in J/(kg-°K)
real ks = 237.;			// thermal conductivity in W/(m-°K)
real alphas = 9.728e-5;	// thermal diffusivity in m^2/s


// Dimensional time step
real ddt = (H^2.)/alphas;	// in seconds

// ------ Stagnant thermal conductivity ------
// Constant parameter and structural function
real r=0.09;
func b=(-r+sqrt(r^2. + (2./sqrt(3))*(1-fphi)*(2.-r*(1+(4./sqrt(3))))))/((2./3)*(2.-r*(1+(4./sqrt(3)))));

// For the solid
func kstgs=(sqrt(3)/2.)/((r*b/((1+b)*ks/3))+((1-r)*b/((2./3)*b*ks))+(((sqrt(3)/2.)-b)/((4*r/(3*sqrt(3)))*b*ks)));

// For the fluid
func kstgf=(sqrt(3)/2.)/((r*b/(kf-(1+b)*kf/3))+((1-r)*b/(kf-(2./3)*b*kf))+(((sqrt(3)/2.)-b)/(kf-(4*r/(3*sqrt(3)))*b*kf)));

// Effective stagnant thermal conductivity
func kstgef=(sqrt(3)/2.)/((r*b/(kf+(1+b)*(ks-kf)/3))+((1-r)*b/(kf+(2./3)*b*(ks-kf)))+(((sqrt(3)/2.)-b)/(kf+(4*r/(3*sqrt(3)))*b*(ks-kf))));




