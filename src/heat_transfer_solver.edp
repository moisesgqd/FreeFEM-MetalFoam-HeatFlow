	for(n = 0; n < 15e3; n++){
		// ENERGY CONSERVATION PROBLEM
		// ------ Update fields ------
		Ofold = Of;
		Osold = Os;

		// Get plate temperature
		Tp = (1/L)*int1d(Th,TopWall)(fphi*Of+(1-fphi)*Os);
		cout << " Average plate temperature is " << Tp << " degK " << endl;

		// Calculate top heat loss coefficient
