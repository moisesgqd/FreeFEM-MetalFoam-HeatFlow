	fileOf0 >> Oalterf[];
	Oalterf[] = Oalterf[]; // just in case

	ifstream fileOs0("E:/CFD_project_-_PhD_Studies/2-Var_porosity/Case_2-Linear_97_83-Channel_2x025/Heat_Transfer/TXT_files/Temp-S_1530_083.txt");
	fileOs0 >> Oalters[];
