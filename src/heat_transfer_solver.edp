// ==========================================================
// Define variables to store physical properties
// ==========================================================

// ===== Define variables to store values ====== 
string property, blank;
real value;
real[string] properties;

// ==========================================================
// Get physical properties
// ==========================================================

{
    ifstream PhysicalData(physicalFile);
    for(int i=0; i<11; i++) {
        PhysicalData >> property >> value;
        properties[property] = value;
    }
} // File will close automatically after this block

// ===== Assign physical properties to variables ======
real g = properties["g"];
real sgm = properties["sgm"];
real eC = properties["eC"];
real eP = properties["eP"];
real rhof = properties["rhof"];
real cpf = properties["cpf"];
real mu = properties["mu"];
real kf = properties["kf"];
real rhos = properties["rhos"];
real cps = properties["cps"];
real ks = properties["ks"];

// ===== Calculate derived physical properties ======
real nu = mu / rhof; // kinematic viscosity
real alphaf = kf / (rhof * cpf); // thermal diffusivity of fluid
real alphas = ks / (rhos * cps); // thermal diffusivity of solid
real Pr = cpf * mu / kf; // Prandtl number

real alphaP = alphaf/alphas;
real kP = kf/ks; // ratio of thermal conductivities

// ==========================================================
// Get weather data
// ==========================================================

// ===== Define variables to store weather data ======
int n=27; // size of the arrays
string[int] hour(n);
real[int] qabs(n), Tamb(n), hwind(n), Tsky(n);

// ===== Read weather data from file ======
{
    ifstream WeatherData(weatherFile);
    WeatherData >> blank; // ignore first line (header)
    for(int i=0; i<n; i++){
        WeatherData >> hour[i] >> qabs[i] >> Tamb[i] >> hwind[i] >> Tsky[i];
    }
} // File will close automatically after this block

// ===== Assign weather data to variables ======
real T0 = Tamb[0]; // Initial temperature of the fluid

// ==========================================================
// Read channel characteristics
// ==========================================================

// ===== Read channel characteristics from file ======
{
    ifstream ChannelData(channelFile);
    for(int i=0; i<6; i++){
        ChannelData >> property >> value;
        properties[property] = value;
    }
} // File will close automatically after this block

// ===== Assign channel characteristics to variables ======
real L = properties["L"];
real H = properties["H"];
real W = properties["W"];
real beta = properties["beta"];
real Lgc = properties["Lgc"];
real Vflow = properties["Vflow"];

// ===== Calculate derived channel characteristics ======
real Ac = H * W; // cross-sectional area of channel
real u0 = Vflow / Ac; // average flow velocity
real ReH = rhof * u0 * H / mu; // Reynolds number based on channel height
real PeH = u0 * H / alphaf; // Peclet number based on channel height

real xiL = H/L; // channel aspect ratio, non-dimensional

real dTc = 1361*H/ks; // characteristic temperature difference based on solar constant: 1361 W/m^2

// ==================================================================================
// Metal foam properties          NOTE: MOST OF THIS SUBSECTION IS MANUALLY MODIFIED
// ==================================================================================

// ===== Porosity =====
// Inputs
real yw = 0.;	// location of wall on y-axis
real yc = 0.0125; 	// location of maximum or minimum in quadratic function
real phib = 0.8; 	// porosity on bottom wall
real phic = 0.9; 	// porosity on center
real phit = 0.97;   // porosity on top wall

// --- Proposed porosity scalar field ---
// Declare if porosity is constant or varies within the domain to print in logs file
bool isPorosityConstant = true; // Set to true if porosity is constant, false if it varies within the domain

// func fphi = phib + (phit - phib)*square(y)/square(H);
func fphi = phib + (phit - phib)*square(y);

// ===== Pore size =====
// --- Constant pore size ---
real dp = 0.0025;

real xip = H/dp; // Pore aspect ratio, non-dimensional

// ===== Filament diameter =====
// --- Model from Calmidi and Mahajan (2000) ---
func fdf = 1.18*dp*sqrt((1.-fphi)/(3*pi))/(1-exp((fphi-1.)/0.04));  // in m

// ===== Tortuosity =====
// --- Model from Du Plesis et al (1994) ---
func Tor = 1./((3./(4*fphi))+((sqrt(9.-8.*fphi))/(2.*fphi))*cos((4*pi/3.)+(1./3)*acos((8.*square(fphi)-36.*fphi+27.)/(((9.-8.*fphi)^(3./2)))))); // in m/m

// ===== Cell size =====
// --- Model from Du Plesis et al (1994) ---
func dc = sqrt(Tor/(3.*fphi))*dp;  // in m

// ===== Specific interfacial area =====
// --- Model from Du Plesis et al (1994) ---
func asf = (3./dc)*(3.-Tor)*(Tor-1.); // in m^2/m^3

// ===== Permeability =====
// --- Model from Calmidi (1998) ---
func rfip=1.18*sqrt((1-fphi)/(3*pi))/(1-exp((fphi-1.)/0.04)); 		// filament to pore size ratio, in m/m
func fK=0.00073*(dp^2)*((1-fphi)^(-0.224))*(rfip^(-1.11)); 		// in m^2

// --- Model from Du Plesis et al (1994) ---
//~ func K = square(phi*dc)/(36.*Tor*(3.-Tor));		// in m^2

// ===== Forchheimer coefficient =====
// --- Model from Calmidi (1998) ---
func cF=0.00212*((1-fphi)^(-0.132))*(rfip^(-1.63)); 		// non-dimensional

// --- Model from Du Plesis et al (1994) ---
//~ func cF = 2.05*Tor*(Tor-1)*sqrt(K)/(square(phi)*(3.-Tor)*dc);

// ===== Stagnant thermal conductivity =====
// Constant parameter and structural function
real r=0.09;
real b=(-r+sqrt(r^2. + (2./sqrt(3))*(1-fphi)*(2.-r*(1+(4./sqrt(3))))))/((2./3)*(2.-r*(1+(4./sqrt(3)))));

// For the solid
real kstgs=(sqrt(3)/2.)/((r*b/((1+b)*ks/3))+((1-r)*b/((2./3)*b*ks))+(((sqrt(3)/2.)-b)/((4*r/(3*sqrt(3)))*b*ks)));

// For the fluid
real kstgf=(sqrt(3)/2.)/((r*b/(kf-(1+b)*kf/3))+((1-r)*b/(kf-(2./3)*b*kf))+(((sqrt(3)/2.)-b)/(kf-(4*r/(3*sqrt(3)))*b*kf)));

// Effective stagnant thermal conductivity
real kstgef=(sqrt(3)/2.)/((r*b/(kf+(1+b)*(ks-kf)/3))+((1-r)*b/(kf+(2./3)*b*(ks-kf)))+(((sqrt(3)/2.)-b)/(kf+(4*r/(3*sqrt(3)))*b*(ks-kf))));

// ==========================================================
// Time and loop control
// ==========================================================

// ===== Loop control variables ======
real maxError = 1e-6; // Maximum error tolerance for convergence

// ===== Output variables ======


// ===== Time control variables ======
int maxIter = 1e6; // Maximum number of iterations for the time loop
real dt = 0.001; // Time step size, either in seconds or in a non-dimensional form


// -------------------------------------------------------------------------------- //
//																					//
// 	      M E S H   H A N D L I N G   A N D   F E M   S P A C E   S E T U P         //
//																					//
// -------------------------------------------------------------------------------- //

// ==========================================================
// Read mesh data
// ==========================================================

// ===== Define variables to store mesh data ======
int nx, ny;
string distX, distY; 
string dim; // is the mesh considering a dimensional domain? Options: "non" (no-dimensional), "noH" (no-dimensional on H), "dim" (dimensional)

// ===== Declare mesh as a global variable =====
// This allows the mesh to be accessed throughout the script without needing to pass it as a parameter
mesh Th;

// ===== Read each line of the file to save its content =====
{
    ifstream meshData(meshDataFile);
    meshData >> blank >> nx;
    meshData >> blank >> ny;
    meshData >> blank >> distX;
    meshData >> blank >> distY;
    meshData >> blank >> dim;
} // File will close automatically after this block

// ===== Generate and print out mesh name to console ======
string meshName = "mesh_" + nx + "x" + ny + "_" + L + "x" + H + "-" + dim + "_" + distX + "-" + distY + ".msh"; // Name of the mesh file to save
cout << "Mesh name: " << meshName << endl;

// ===== Check if mesh file exists =====
// If the mesh file does not exist, generate it
try{
    Th = readmesh(home + "mesh/" + meshName); // Read the mesh from a file
    if(bPlotMesh) plot(Th, wait = false, cmm = "Mesh of the porous duct"); // Plot the mesh if bPlotMesh is true
}
catch(...){
    cout <<  "                 -----> File not found. GENERATE THE MESH." << endl;
    exit(0);
}

// Check if the mesh is correct or not
if(bPlotMesh){
    string checkMesh = "N"; // Variable to check if the porosity field is correct
    cout << "Is the mesh correct? Y for yes, anything else for no: "; cin >> checkMesh;
    if (checkMesh != "Y" && checkMesh != "y") {
        cout << "Mesh is not correct. Please check the input parameters." << endl;
        exit(0);
    }
    else {
        cout << "Mesh is correct." << endl;
    }
}

// ===== Wall identification =====
// Since the square mesh was generated with the default FreeFEM options, the walls are identified as follows:
int BottomWall = 1;
int Outlet = 2;
int TopWall= 3;
int Inlet = 4;

// ==========================================================
// Create finite element spaces
// ==========================================================

// ===== Declare finite element base ======
fespace Vh(Th, P2); // P2 elements

// ===== Define finite element spaces ======
// --- Velocity fields ---
Vh u, v, sqrtu, sqrtv, uaux, vaux, uphi, vphi;

// --- Temperature fields ---
Vh Of=0, Os=0;

// --- Previous iteration fields ---
Vh Ofold, Osold, Ofaux, Osaux;

// --- Test or weighting functions ---
Vh wf, ws;

// --- Porosity as a finite element space ---
Vh phi=fphi;

// --- Solution spaces ---
Vh solEnerF, solEnerS;

// Check if the provided porosity is physically correct or not
if(bPlotMesh){
    plot(phi, wait = false, cmm = "Porosity field", fill = true, value = true); // Plot the porosity field for checking
    string checkPorosity = "N"; // Variable to check if the porosity field is correct
    cout << "Is porosity field correct? Y for yes, anything else for no: "; cin >> checkPorosity;
    if (checkPorosity != "Y" && checkPorosity != "y") {
        cout << "Porosity field is not correct. Please check the input parameters." << endl;
        exit(0);
    }
    else {
        cout << "Porosity field is correct." << endl;
    }
}

// ==========================================================
// Import veloctity fields
// ==========================================================

{
    ifstream fileU(home + "results/Velocity_X/velocity_U_400.txt");
    fileU >> uaux[];
}

u[] = uaux[];
uphi = u/phi;

{
    ifstream fileV(home + "results/Velocity_Y/velocity_V_400.txt");
    fileV >> vaux[];
}

v[] = vaux[];
vphi = v/phi;


// ===== Generate square root velocity fields =====
// sqrtu = sqrt(u); // Calculate the square root of the velocity field U
// sqrtv = sqrt(v); // Calculate the square root of the velocity field V

// {
//     ofstream fileSqrtU(home + "results/Velocity_X/sqrt_velocity_U_400.txt");
//     fileSqrtU << sqrtu[] << endl;
// }

// {
//     ofstream fileSqrtV(home + "results/Velocity_Y/sqrt_velocity_V_400.txt");
//     fileSqrtV << sqrtv[] << endl;
// }


// ===== Read square root velocity fields from files =====
{
    ifstream fileSqrtU(home + "results/Velocity_X/sqrt_velocity_U_400.txt");
    fileSqrtU >> sqrtu[];
}

sqrtu[] = sqrtu[];

{
    ifstream fileSqrtV(home + "results/Velocity_Y/sqrt_velocity_V_400.txt");
    fileSqrtV >> sqrtv[];
}

sqrtv[] = sqrtv[];

plot(u, wait = true, cmm = "Velocity field U", fill = true, value = true);
plot(sqrtu, wait = true, cmm = "Sqrt Velocity field U", fill = true, value = true);

// ==========================================================
// Calculate top heat loss coefficient
// ==========================================================

// ===== Air properties models =====
// Properties have been approximated and corrected for 0.767 atm, the atmospheric pressure in Mexico City
// The temperatures MUST BE in Kelvin.

// Density in kg/m^3
func real AirDensity(real Temp){
	return (7.9254079e-9)*(Temp^4)-(9.1923232e-6)*(Temp^3)+(4.0049854e-3)*(Temp^2)-0.78007994*Temp+58.475556;
}

// Specific heat in J/(kg-degK)
func real AirSpecHeat(real Temp){
	return -(1.32867133e-6)*(Temp^4)+0.0015839259*(Temp^3)-0.708214367*(Temp^2)+140.7945016*Temp-9495.720001;
}

// Thermal conductivity in W/(m-degK)
func real AirThermConduc(real Temp){
	return (7.4592075e-11)*(Temp^4)-(8.8005387e-8)*(Temp^3)+(3.8884941e-5)*(Temp^2)-(0.0075513952)*Temp+0.563371025;
}

// Thermal diffusivity in m^2/s
func real AirThemDiff(real Temp){
	return -(4.7138047e-13)*(Temp^3)+(6.617417e-10)*(Temp^2)-(9.4213142e-8)*Temp+(9.6356601e-6);
}

// Kinematic viscosity in m^2/s
func real AirKineVisco(real Temp){
	return -(1.1447811e-12)*(Temp^3)+(1.1357821e-9)*(Temp^2)-(2.5183443e-7)*Temp+(2.479905e-5);
}

// Prandtl number
func real AirPrandtl(real Temp){
	return -(2.331002e-10)*(Temp^4)+(2.87475e-7)*(Temp^3)-0.000132727*(Temp^2)+0.026919479*Temp-1.275047426;
}


// ===== Declare variables =====
// Temperatures are in Kelvin
// Declare necessary variables
int nn;					// counter
real TempCover;			// Cover temperature
real TempCoverPrv;		// Previous iteration over temperature
real TempAvg;			// Average temperatures between plate and cover
real Ut=5.0;			// Top heat loss coefficient
real eT;				// Temperature difference
real Pra;				// Air Prandlt number
real nua;				// Air kinematic viscosity
real ka;				// Air thermal conductivity
real Ra;				// Rayleigh number
real ParA;				// A criteria parameter
real Nupp;				// Parallel plate Nusselt number

real hrpc;				// HT coefficient for radiation between plate and cover
real hrca;				// HT coefficient for radiation between cover and ambient
real hcpc;				// HT coefficient for convection between plate and cover


// ===== Top heat loss function =====
func real TopHeatLoss(real TempAmb, real TempSky, real TempPlate, real CoefWind, real PlateIncl){

	// Initial guess of cover temperature
	TempCover = 0.5*(TempAmb + TempPlate);

	// Main loop
	for(nn=0; nn<10; nn++){
		// Update previous temperature value
		TempCoverPrv = TempCover;

		// Calculate plate-cover average temperature
		TempAvg = 0.5*(TempPlate + TempCover);

		// Based on previous temperature, estimate a few air properties
		Pra = AirPrandtl(TempAvg);
		nua = AirKineVisco(TempAvg);
		ka = AirThermConduc(TempAvg);

		// Get Rayleigh number
		Ra = g*abs(TempPlate - TempCover)*(Lgc^3.)*Pra/(TempAvg*square(nua));

		// Estimate a paremeter
		ParA = Ra*cos(PlateIncl);

		// Get Nusselt number for parallel plates
		if(ParA > 5830.0){
			Nupp = 1.44*(1-1708*((sin(1.8*PlateIncl))^(1.6))/ParA)*(1-1708./ParA)+((ParA/5830)^(1./3));
		}
		else{
			if(ParA > 1708.0){
				Nupp = 1.+1.44*(1-1708*((sin(1.8*PlateIncl))^(1.6))/ParA)*(1.-1708/ParA);
			}
			else{
				Nupp = 1.0;
			}
		}

		// And from that, estimate convection coefficient
		hcpc = Nupp*ka/Lgc;

		// Calculate radiation HT coefficients
		hrpc = sgm*(TempPlate+TempCover)*(square(TempPlate)+square(TempCover))/((1./eP)+(1./eC)-1);
		hrca = sgm*eC*(TempCover+TempSky)*(square(TempCover)+square(TempSky));

		// Top heat loss coefficient
		Ut = 1./((1./(hcpc + hrpc))+(1./(CoefWind + hrca)));

		// New cover temperature
		TempCover = TempPlate - Ut*(TempPlate - TempAmb)/(hcpc + hrpc);

		eT = abs(TempCover - TempCoverPrv);

		if(eT <= 0.005) break;

	}
	return Ut;
}


// ==========================================================
// Finite element function definitions
// ==========================================================

// ===== Dispersion effect as a thermal conductivity =====
// --- Calmada and Mahajan (2000) model---
Vh kdisX = 0.06*rhof*cpf*u*sqrt(fK);
Vh kdisY = 0.00444*kdisX; 						// Based on Celik et al (2018) long-transv ratio of thermal dispersion

// ===== Interfacial heat transfer coefficient =====
// --- Pore diameter Reynolds number ---
Vh sqrtRep = sqrtu*sqrt(dp/nu); 
plot(sqrtRep, wait = true, cmm = "Square root pore Reynolds number", fill = true, value = true);

// --- Interfacial Nusselt number ---
Vh Nuv = 0.94*asf*((dp^(1.5))/(fdf^(0.5)))*(((2+phi)/3)^(0.63))*sqrtRep*(Pr^0.37);

// --- Interfacial HT coefficient ---
Vh hv = (kf/square(dp))*Nuv;

plot(Nuv, wait = true, cmm = "Interfacial Nusselt number", fill = true, value = true);

// -------------------------------------------------------------------------------- //
//																					//
// 	              M A T H E M A T I C A L   M O D E L   S E T U P                   //
//																					//
// -------------------------------------------------------------------------------- //

real qa, Ta, Tp, Ts, hw;

Vh mx = ((2+phi)/3)+kdisX/kf;
Vh my = ((2+phi)/3)+kdisY/kf;
Vh ms = (1-phi)/3;

varf EnergyFluid (Of, wf)
	=int2d(Th)(
		(fphi/(alphaP*dt))*Of*wf
		+ square(xiL)*mx*dx(Of)*dx(wf)
		+ my*dy(Of)*dy(wf)
	)
	+ int2d(Th)(
		wf*(
			(fphi/(alphaP*dt))*convect([xiL*PeH*alphaP*uphi, xiL*PeH*alphaP*vphi],-dt,Ofold)
			+ square(xiL)*dx(mx)*dx(Ofold)
			+ dy(my)*dy(Ofold)
			+ square(xip)*Nuv*(Osold-Ofold)
		)
	)
	+ int1d(Th,TopWall)(
		wf*H*fphi*(qa-Ut*(Tp-Ta))/(dTc*kf)
	)
	+on(Inlet, Of=0)
;

varf EnergySolid (Os, ws)
	=int2d(Th)(
		  ((1-fphi)/dt)*Os*ws
		+ square(xiL)*ms*dx(Os)*dx(ws)
		+ ms*dy(Os)*dy(ws)
	)
	+ int2d(Th)(
		ws*(
			((1-fphi)/dt)*Osold
			+ square(xiL)*dx(ms)*dx(Osold)
			+ dy(ms)*dy(Osold)
			+ Nuv*kP*square(xiL)*(Ofold-Osold)
		)
	)
	+ int1d(Th,TopWall)(
		ws*(1.-fphi)*(qa-Ut*(Tp-Ta))*H/(dTc*ks)
	)
;


// -------------------------------------------------------------------------------- //
//																					//
// 	                L I N E A R   S Y S T E M   A S S E M B L Y                     //
//																					//
// -------------------------------------------------------------------------------- //

// ==========================================================
// Define stiffness matrices
// ==========================================================

matrix AEnerF;			// Matrix for the energy problem for the fluid
matrix AEnerS;			// Matrix for the energy problem for the solid

// ==========================================================
// Define right hand side vectors
// ==========================================================

real[int] bEnerF(Vh.ndof);			// Vector for the energy problem for the fluid
real[int] bEnerS(Vh.ndof);			// Vector for the energy problem for the solid

// ==========================================================
// Construct the linear system
// ==========================================================

// ===== Assemble the stiffness matrices =====

AEnerF = EnergyFluid(Vh,Vh);
AEnerS = EnergySolid(Vh,Vh);

// ===== Assemble the right hand side vectors =====

bEnerF = EnergyFluid(0,Vh);
bEnerS = EnergySolid(0,Vh);

// -------------------------------------------------------------------------------- //
//																					//
//                       T I M E   S O L V E R   L O O P                            //
//																					//
// -------------------------------------------------------------------------------- //

// ==========================================================
// Get weather data
// ==========================================================

qa = qabs[12]; // Absorbed solar radiation in W/m^2
Ta = Tamb[12]; // Ambient temperature in Kelvin
Ts = Tsky[12]; // Sky temperature in Kelvin
hw = hwind[12]; // Wind speed in m/s

real errf;

// ===== Initialize the time loop =====
// cout << "Starting time loop with maximum iterations: " << maxIter << endl;

for(int n=0; n < maxIter; n++){	
	cout << "Iteration: " << n << endl;
    // ==========================================================
    // Update main variables
    // ==========================================================
    
	Ofold = Of;
	Osold = Os;

	// ===== Get plate temperature =====
	Tp = (1/L)*int1d(Th,TopWall)(fphi*Of+(1-fphi)*Os)*dTc+273.15;

	cout << "Plate temperature: " << Tp << " K" << endl;

	// ===== Calculate top heat loss coefficient =====
	Ut = TopHeatLoss(Ta, Ts, Tp, hw, beta);

	cout << "Top heat loss coefficient: " << Ut << " W/(m^2-K)" << endl;

	// ===== Reconstruct RHS vectors =====
	bEnerF = EnergyFluid(0,Vh);
	bEnerS = EnergySolid(0,Vh);
	
	// ===== Solve coupled energy problem =====
	solEnerF[] = AEnerF^-1 * bEnerF;
	solEnerS[] = AEnerS^-1 * bEnerS;

	Of = solEnerF;
	Os = solEnerS;

    // ==========================================================
    // Error and outputs
    // ==========================================================

    // ===== Calculate error and outflux =====

    
    // ===== Plot data to verify    
	if ( n%10 == 0 && bPlotData) {
		plot(Of, wait = false, cmm = "Fluid Temperature", fill = true, value = true);

		errf = sqrt(int2d(Th)(square(Of-Ofold))/Th.area);
		cout << "Error in fluid temperature: " << errf << endl;

		// plot(Os, wait = false, cmm = "Solid Temperature", fill = true, value = true);
	}

    // ===== Export data if conditions are met =====


    // ===== Apply stoping criteria =====

}