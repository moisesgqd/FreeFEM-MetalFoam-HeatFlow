string sTextVelX, sTextVelY, sTextPres, sTextTempF, sTextTempS;
string sVTUVelX, sVTUVelY, sVTUPres, sVTUTempF, sVTUTempS;

int[int] OrderOut = [1];

// Function to add zeros to the left of numbers less than 1000, as a string
func string ThreeDigitInteger(int NaturalNumb){
	string sResult;
	if(NaturalNumb < 10){
		sResult = "00" + NaturalNumb;
	}
	else{
		if(NaturalNumb < 100){
			sResult = "0" + NaturalNumb;
		}
		else{
			sResult = NaturalNumb;
		}
	}
	return sResult;
}

