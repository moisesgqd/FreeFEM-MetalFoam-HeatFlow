// -------------------------------------------------------------------------------- //
//																					//
//       	    E N V I R O N M E N T   A N D   D E B U G   S E T U P   		    //
//																					//
// -------------------------------------------------------------------------------- //

// ==========================================================
// Package loading
// ==========================================================

// ===== Exporting data in VTU format =====
// For later visualization in Paraview
load "iovtk"

// ==========================================================
// Debugging Options
// ==========================================================

// ===== Enable debugging options ======
// For sanity check
verbosity = false; // Set to true to enable detailed output
bool bPlotMesh = true; // Set to true to plot the mesh
bool bPlotData = false; // Set to true to plot the data
bool bExportData = true; // Set to true to export data in dat format

// ===== Absolute and relative paths =====
// To read and save data files
string home = "E:/FreeFEM_projects/PhD_research/porous_duct/";
string physicalFile = home + "data/physical_parameters.txt"; // file containing 11 physical parameters
string weatherFile = home + "data/weather_data.txt"; // file containing weather data
string channelFile = home + "data/channel_characteristics.txt"; // file containing channel characteristics
string meshDataFile = home + "data/mesh_data.txt"; // file containing mesh data

// -------------------------------------------------------------------------------- //
//																					//
// 	    I N P U T   A N D   P A R A M E T E R   I N I T I A L I Z A T I O N   		//
//																					//
// -------------------------------------------------------------------------------- //

// ==========================================================
// Define variables to store physical properties
// ==========================================================

// ===== Define variables to store values ====== 
string property, blank;
real value;
real[string] properties;

// ==========================================================
// Get physical properties
// ==========================================================

{
    ifstream PhysicalData(physicalFile);
    for(int i=0; i<11; i++) {
        PhysicalData >> property >> value;
        properties[property] = value;
    }
} // File will close automatically after this block

// ===== Assign physical properties to variables ======
real g = properties["g"];
real sgm = properties["sgm"];
real eC = properties["eC"];
real eP = properties["eP"];
real rhof = properties["rhof"];
real cpf = properties["cpf"];
real mu = properties["mu"];
real kf = properties["kf"];
real rhos = properties["rhos"];
real cps = properties["cps"];
real ks = properties["ks"];

// ===== Calculate derived physical properties ======
real nu = mu / rhof; // kinematic viscosity
real alphaf = kf / (rhof * cpf); // thermal diffusivity of fluid
real alphas = ks / (rhos * cps); // thermal diffusivity of solid
real Pr = cpf * mu / kf; // Prandtl number

// ==========================================================
// Get weather data
// ==========================================================

// ===== Define variables to store weather data ======
// int n=27; // size of the arrays
// string[int] hour(n);
// real[int] qabs(n), Tamb(n), hwind(n), Tsky(n);

// // ===== Read weather data from file ======
// {
//     ifstream WeatherData(weatherFile);
//     WeatherData >> blank; // ignore first line (header)
//     for(int i=0; i<n; i++){
//         WeatherData >> hour[i] >> qabs[i] >> Tamb[i] >> hwind[i] >> Tsky[i];
//     }
// } // File will close automatically after this block

// ==========================================================
// Read channel characteristics
// ==========================================================

// ===== Read channel characteristics from file ======
{
    ifstream ChannelData(channelFile);
    for(int i=0; i<6; i++){
        ChannelData >> property >> value;
        properties[property] = value;
    }
} // File will close automatically after this block

// ===== Assign channel characteristics to variables ======
real L = properties["L"];
real H = properties["H"];
real W = properties["W"];
real beta = properties["beta"];
real Lgc = properties["Lgc"];
real Vflow = properties["Vflow"];

// ===== Calculate derived channel characteristics ======
real Ac = H * W; // cross-sectional area of channel
real u0 = Vflow / Ac; // average flow velocity
real ReH = rhof * u0 * H / mu; // Reynolds number based on channel height

real xiL = H/L; // channel aspect ratio, non-dimensional

// ==================================================================================
// Metal foam properties          NOTE: MOST OF THIS SUBSECTION IS MANUALLY MODIFIED
// ==================================================================================

// ===== Porosity =====
// Inputs
real yw = 0.;	// location of wall on y-axis
real yc = 0.0125; 	// location of maximum or minimum in quadratic function
real phib = 0.8; 	// porosity on bottom wall
real phic = 0.9; 	// porosity on center
real phit = 0.97;   // porosity on top wall

// --- Proposed porosity scalar field ---
// Declare if porosity is constant or varies within the domain to print in logs file
bool isPorosityConstant = true; // Set to true if porosity is constant, false if it varies within the domain

// func fphi = phib + (phit - phib)*square(y)/square(H);
func fphi = phib + (phit - phib)*square(y);

// ===== Pore size =====
// --- Constant pore size ---
real dp = 0.0025;

real xip = H/dp; // Pore aspect ratio, non-dimensional

// ===== Filament diameter =====
// --- Model from Calmidi and Mahajan (2000) ---
func fdf = 1.18*dp*sqrt((1.-fphi)/(3*pi))/(1-exp((fphi-1.)/0.04));  // in m

// ===== Tortuosity =====
// --- Model from Du Plesis et al (1994) ---
func Tor = 1./((3./(4*fphi))+((sqrt(9.-8.*fphi))/(2.*fphi))*cos((4*pi/3.)+(1./3)*acos((8.*square(fphi)-36.*fphi+27.)/(((9.-8.*fphi)^(3./2)))))); // in m/m

// ===== Cell size =====
// --- Model from Du Plesis et al (1994) ---
func dc = sqrt(Tor/(3.*fphi))*dp;  // in m

// ===== Specific interfacial area =====
// --- Model from Du Plesis et al (1994) ---
func asf = (3./dc)*(3.-Tor)*(Tor-1.); // in m^2/m^3

// ===== Permeability =====
// --- Model from Calmidi (1998) ---
func rfip=1.18*sqrt((1-fphi)/(3*pi))/(1-exp((fphi-1.)/0.04)); 		// filament to pore size ratio, in m/m
func fK=0.00073*(dp^2)*((1-fphi)^(-0.224))*(rfip^(-1.11)); 		// in m^2

// --- Model from Du Plesis et al (1994) ---
//~ func K = square(phi*dc)/(36.*Tor*(3.-Tor));		// in m^2

// ===== Forchheimer coefficient =====
// --- Model from Calmidi (1998) ---
func cF=0.00212*((1-fphi)^(-0.132))*(rfip^(-1.63)); 		// non-dimensional

// --- Model from Du Plesis et al (1994) ---
//~ func cF = 2.05*Tor*(Tor-1)*sqrt(K)/(square(phi)*(3.-Tor)*dc);


// ==========================================================
// Time and loop control
// ==========================================================

// ===== Loop control variables ======
real error; // Difference between the current and previous iteration
real outflux; // Velocity dot product with the normal vector at the outlet
real maxError = 1e-6; // Maximum error tolerance for convergence

// ===== Output variables ======
real avgUin, avgUout; // Average velocities at the inlet and outlet

// ===== Time control variables ======
int maxIter = 1e6; // Maximum number of iterations for the time loop
real dt = 0.0000001; // Time step size, either in seconds or in a non-dimensional form

// ===== Identifiers =====
string UFile, VFile, PFile; // Output files for velocity and pressure
string Udir, Vdir, Pdir; // Directories to save the data files
// -------------------------------------------------------------------------------- //
//																					//
// 	      M E S H   H A N D L I N G   A N D   F E M   S P A C E   S E T U P         //
//																					//
// -------------------------------------------------------------------------------- //

// ==========================================================
// Read mesh data
// ==========================================================

// ===== Define variables to store mesh data ======
int nx, ny;
string distX, distY; 
string dim; // is the mesh considering a dimensional domain? Options: "non" (no-dimensional), "noH" (no-dimensional on H), "dim" (dimensional)

// ===== Declare mesh as a global variable =====
// This allows the mesh to be accessed throughout the script without needing to pass it as a parameter
mesh Th;

// ===== Read each line of the file to save its content =====
{
    ifstream meshData(meshDataFile);
    meshData >> blank >> nx;
    meshData >> blank >> ny;
    meshData >> blank >> distX;
    meshData >> blank >> distY;
    meshData >> blank >> dim;
} // File will close automatically after this block

// ===== Generate and print out mesh name to console ======
string meshName = "mesh_" + nx + "x" + ny + "_" + L + "x" + H + "-" + dim + "_" + distX + "-" + distY + ".msh"; // Name of the mesh file to save
cout << "Mesh name: " << meshName << endl;

// ===== Check if mesh file exists =====
// If the mesh file does not exist, generate it
try{
    Th = readmesh(home + "mesh/" + meshName); // Read the mesh from a file
    if(bPlotMesh) plot(Th, wait = false, cmm = "Mesh of the porous duct"); // Plot the mesh if bPlotMesh is true
}
catch(...){
    cout <<  "                 -----> File not found. GENERATE THE MESH." << endl;
    exit(0);
}

// Check if the mesh is correct or not
if(bPlotMesh){
    string checkMesh = "N"; // Variable to check if the porosity field is correct
    cout << "Is the mesh correct? Y for yes, anything else for no: "; cin >> checkMesh;
    if (checkMesh != "Y" && checkMesh != "y") {
        cout << "Mesh is not correct. Please check the input parameters." << endl;
        exit(0);
    }
    else {
        cout << "Mesh is correct." << endl;
    }
}

// ===== Wall identification =====
// Since the square mesh was generated with the default FreeFEM options, the walls are identified as follows:
int BottomWall = 1;
int Outlet = 2;
int TopWall= 3;
int Inlet = 4;

// ==========================================================
// Create finite element spaces
// ==========================================================

// ===== Declare finite element base ======
fespace Vh(Th, P2); // P2 elements

// ===== Define finite element spaces ======
// --- Main variables ---
// Set to zero as the initial condition
Vh u=0, v=0, p=0;

// --- Test or weight functions ---
Vh uT, vT, q, uW, vW;

// --- Auxiliary variables ---
Vh ua, uaa, va, vaa;

// --- Intrinsic velocity field ---
Vh uphi=u/fphi, vphi=v/fphi;

// --- Previous time step variables or old values ---
Vh uold=u, vold=v, pold=p;

// --- Solution spaces ---
Vh solComX, solComY, solPres;
Vh solCorX, solCorY;

// --- Porosity as a finite element space ---
Vh phi=fphi;

// Check if the provided porosity is physically correct or not
if(bPlotMesh){
    plot(phi, wait = false, cmm = "Porosity field", fill = true, value = true); // Plot the porosity field for checking
    string checkPorosity = "N"; // Variable to check if the porosity field is correct
    cout << "Is porosity field correct? Y for yes, anything else for no: "; cin >> checkPorosity;
    if (checkPorosity != "Y" && checkPorosity != "y") {
        cout << "Porosity field is not correct. Please check the input parameters." << endl;
        exit(0);
    }
    else {
        cout << "Porosity field is correct." << endl;
    }
}

// -------------------------------------------------------------------------------- //
//																					//
// 	              M A T H E M A T I C A L   M O D E L   S E T U P                   //
//																					//
// -------------------------------------------------------------------------------- //

// ===== Boundary conditions =====
// Inlet velocity function
// This function defines the velocity at the inlet of the duct
func uy = 6*y - 6*(y^2);

// ==========================================================
// Compressible modified Navier-Stokes equations
// ==========================================================

// ===== Solve compressible part of modifies Navier-Stokes equations =====
// In the x-direction
varf CompressibleX(ua, uT)
    = int2d(Th)(
        ua*uT/dt 
        + dx(ua)*dx(uT) + dy(ua)*dy(uT)
    )
    + int2d(Th)(
        (uT/dt)*convect([ReH*uphi,ReH*xiL*vphi], -dt, uold)
    )
    + on(Inlet, ua = uy) // Inlet function for x-velocity along the y-axis
    + on(TopWall, BottomWall, ua = 0) // No-slip condition on walls
;

// In the y-direction
varf CompressibleY(va, vT)
    = int2d(Th)(
        xiL*va*vT/dt 
        + xiL*dx(va)*dx(vT) + xiL*dy(va)*dy(vT)
    )
    + int2d(Th)(
        (xiL*vT/dt)*convect([ReH*uphi,ReH*xiL*vphi], -dt, vold)
    )
    + on(Inlet, TopWall, BottomWall, va = 0) // Vertical velocity is zero at the inlet, plus no-slip condition on walls
;

// ==========================================================
// Pressure correction equation
// ==========================================================

// Using the continuity equation to reduce the equation
// Outlet to the ambient, with atmosferic pressure of zero
varf Pressure(p, q)
	= int2d(Th)(
		(square(xip)*phi/xiL)*(
            dx(p)*dx(q)	+ dy(p)*dy(q))
	)
	+ int2d(Th)(
		q*(
            dx(uaa)+ dy(vaa)
		    + (square(xip)/xiL)*(dx(phi)*dx(pold) + dy(phi)*dy(pold))
		)
	)
	+ on(Outlet, p=0)
;

// ==========================================================
// Applied pressure correction
// ==========================================================

// ===== Applied pressure correction to the velocity field =====
// In the x-direction
varf CorrectionX(u, uW)
    = int2d(Th)(
        u*uW/dt
    )
    - int2d(Th)(
        uW*(
            uaa
            + (square(xip)*phi/xiL)*dx(p)
        )
    )
    + on(Inlet, u=uy)
    + on(TopWall, BottomWall, u=0) // No-slip condition on walls
;

// In the y-direction
varf CorrectionY(v, vW)
    = int2d(Th)(
        xiL*v*vW/dt
    )
    - int2d(Th)(
        vW*(
            vaa
            + (square(xip)*phi/xiL)*dy(p)
        )
    )
    + on(Inlet, TopWall, BottomWall, v=0) // Vertical velocity is zero at the inlet, plus no-slip condition on walls
;

// -------------------------------------------------------------------------------- //
//																					//
// 	                L I N E A R   S Y S T E M   A S S E M B L Y                     //
//																					//
// -------------------------------------------------------------------------------- //

// ==========================================================
// Define stiffness matrices
// ==========================================================
matrix AcomX;			// Matrix for the velocity compressible part in X-direction
matrix AcomY;			// Matrix for the velocity compressible part in Y-direction
matrix Apres;			// Matrix for the pressure estimation
matrix AcorX;			// Matrix for the velocity correction part in X-direction
matrix AcorY;			// Matrix for the velocity correction part in Y-direction


// ==========================================================
// Define right hand side vectors
// ==========================================================
real[int] bcomX(Vh.ndof);			// Vector for the velocity compressible part in X-direction
real[int] bcomY(Vh.ndof);			// Vector for the velocity compressible part in Y-direction
real[int] bpres(Vh.ndof);			// Vector for the pressure estimation
real[int] bcorX(Vh.ndof);			// Vector for the velocity correction part in X-direction
real[int] bcorY(Vh.ndof);			// Vector for the velocity correction part in Y-direction


// ==========================================================
// Construct the linear system
// ==========================================================

// ===== Assemble the stiffness matrices =====
AcomX = CompressibleX(Vh,Vh);
AcomY = CompressibleY(Vh,Vh);
Apres = Pressure(Vh,Vh);
AcorX = CorrectionX(Vh,Vh);
AcorY = CorrectionY(Vh,Vh);

// ===== Assemble the right hand side vectors =====
bcomX = CompressibleX(0,Vh);
bcomY = CompressibleY(0,Vh);
bpres = Pressure(0,Vh);
bcorX = CorrectionX(0,Vh);
bcorY = CorrectionY(0,Vh);

// -------------------------------------------------------------------------------- //
//																					//
//                       T I M E   S O L V E R   L O O P                            //
//																					//
// -------------------------------------------------------------------------------- //

real inltavgU, outavgU;

// ===== Initialize the time loop =====
cout << "Starting time loop with maximum iterations: " << maxIter << endl;

for(int n=0; n < maxIter; n++){

    // ==========================================================
    // Update main variables
    // ==========================================================
    
    pold = p; // Store the old pressure field
    uold = u; // Store the old x-velocity field
    vold = v; // Store the old y-velocity field

    // ==========================================================
    // Compressible part
    // ==========================================================

    // ===== Intrinsic velocity field =====
    uphi = uold / fphi; // Update intrinsic x-velocity field
    vphi = vold / fphi; // Update intrinsic y-velocity field

    // ===== Reconstruct RHS vectors =====
    bcomX = CompressibleX(0,Vh);
    bcomY = CompressibleY(0,Vh);

    // ===== Solve =====
    solComX[] = AcomX^-1 * bcomX;
    solComY[] = AcomY^-1 * bcomY;

    // --- and the update compressible velocity fields ---
    ua = solComX;
    va = solComY;

    // ==========================================================
    // Pressure
    // ==========================================================

    // ===== Auxliary fields =====
    // --- Update intrinsic velocity fields for pressure correction
    uphi=ua/phi;
    vphi=va/phi;

    // --- Auxiliary variables for pressure correction ---
    uaa=((phi*square(H)/fK)+(phi*cF*H/sqrt(fK))*ReH*sqrt(ua^2+(xiL*va)^2)-(1./dt)-ReH*(ua/(square(phi)))*dx(phi)-ReH*xiL*(va/(square(phi)))*dy(phi))*ua+dx(phi)*dx(uphi)+dy(phi)*dy(uphi);
    vaa=((phi*square(H)/fK)+(phi*cF*H/sqrt(fK))*ReH*sqrt(ua^2+(xiL*va)^2)-(1./dt)-ReH*(ua/(square(phi)))*dx(phi)-ReH*xiL*(va/(square(phi)))*dy(phi))*xiL*va+xiL*dx(phi)*dx(vphi)+xiL*dy(phi)*dy(vphi);
    
    // ===== Reconstruct RHS vectors =====
    bpres = Pressure(0,Vh);
    
    // ===== Solve =====
    solPres[] = Apres^-1 * bpres;
    p = solPres;	 // Update pressure field

    // ==========================================================
    // Correction of velocity field
    // ==========================================================

    // ===== Reconstruct RHS vectors =====
    bcorX = CorrectionX(0,Vh);
    bcorY = CorrectionY(0,Vh);

    // ===== Solve =====
    solCorX[] = AcorX^-1 * bcorX;
    solCorY[] = AcorY^-1 * bcorY;

    // --- and update fields, just in case ---
    u=solCorX;
    v=solCorY;

    // ==========================================================
    // Error and outputs
    // ==========================================================

    // ===== Calculate error and outflux =====
    error = sqrt(int2d(Th)(square(u-uold)+square(v-vold))/Th.area);	
    outflux = int1d(Th)(u*N.x + v*N.y);
    avgUin = int1d(Th, Inlet)(u);
    avgUout = int1d(Th, Outlet)(u);

    cout << "iter = " << n << " , Error L2 = " << error << " , outflux = " << outflux << " . Average inlet U = " << avgUin << " and oulet = " << avgUout << endl;

    
    if(n%10 == 0){
        // ===== Plot data to verify    
        plot(u, wait = false, cmm = "X-velocity field at iteration " + n, value = true, fill=true);

        // ===== Export data if conditions are met =====
        if(n%100 == 0 && bExportData){
            // --- ofstream names ---
            UFile = "VelocityU" + n;
            VFile = "VelocityV" + n;
            PFile = "Pressure" + n;

            // --- Directories ---
            Udir = home + "results/Velocity_X/velocity_U_" + n + ".txt";
            Vdir = home + "results/Velocity_Y/velocity_V_" + n + ".txt";
            Pdir = home + "results/Pressure/pressure_" + n + ".txt";

            // --- Export data to files ---
            // Export velocity on x direction
            ofstream UFile(Udir);
            UFile << u[] << endl;
            
            // Exiort velocity on y direction
            ofstream VFile(Vdir);
            VFile << v[] << endl;

            // Export pressure
            ofstream PFile(Pdir);
            PFile << p[] << endl;

            // ===== Apply stoping criteria =====
            if(error < maxError ){
                cout << "Convergence achieved with error: " << error << endl;
                cout << "Average inlet U = " << avgUin << " and outlet = " << avgUout << endl;
                cout << "Exiting time loop." << endl;
                break; // Exit the loop if convergence is achieved
            }
        }
    }
}