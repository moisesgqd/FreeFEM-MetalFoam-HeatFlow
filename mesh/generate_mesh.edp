//////////////////////////////////////////////////////////////
// Mesh generator for a porous duct simulation
// File: generate_mesh.edp
// Description: Simulation of fluid flow in a porous duct
// Author: Moises Quintanilla
// Date: 25-06-2025
//////////////////////////////////////////////////////////////


// ==========================================================
// Preparation Section
// ==========================================================

// ===== Debugging =====
verbosity = false; // Set to true to enable detailed output
bool bPlotMesh = true;
string[int] distributions = ["linear", "quad", "trigo"]; // Possible values for the mesh distribution: "linear", "quad", "trigo"
string[int] vardimension = ["non", "noH", "dim"]; // Possible values for the mesh dimension: "non" (no-dimensional), "noH" (no-dimensional on H), "dim" (dimensional)


// ===== Relative and absolute paths =====
// Define the home directory for the project
// This path should be adjusted based on the user's directory structure
string home = "E:/FreeFEM_projects/PhD_research/porous_duct/";

// Define the paths for mesh data and channel characteristics
string meshDataFile = home + "data/mesh_data.txt"; // file containing mesh data
string channelFile = home + "data/channel_characteristics.txt"; // file containing channel characteristics

// ==========================================================
// Inputs Section
// ==========================================================

// ========== Read channel characteristics ==========

// --- Open file and define variables to save data ---
// The file gets closed automatically when all the lines are read
ifstream ChannelData(channelFile);
string property;
real value;
real[string] properties;

// --- Read each line of the file to save its content ---
for(int i=0; i<3; i++){
    ChannelData >> property >> value;
    properties[property] = value;
}

// --- Save the properties in variables for easy access ---
real L = properties["L"];
real H = properties["H"];
real W = properties["W"];


// ========== Read mesh data ==========

// --- Open file and define variables to save data ---
// The file gets closed automatically when all the lines are read
ifstream meshData(meshDataFile);
int nx, ny;
string blank, distX, distY; 
string dim; // is the mesh considering a dimensional domain? Options: "non" (no-dimensional), "noH" (no-dimensional on H), "dim" (dimensional)

// --- Read each line of the file to save its content ---
meshData >> blank >> nx;
meshData >> blank >> ny;
meshData >> blank >> distX;
meshData >> blank >> distY;
meshData >> blank >> dim;

// ==========================================================
// Mesh Verification/Creation Section
// ==========================================================

// ========== Check if the mesh already exists ==========

// --- Define the mesh name based on the input parameters ---
string meshName = "mesh_" + nx + "x" + ny + "_" + L + "x" + H + "-" + dim + "_" + distX + "-" + distY + ".msh"; // Name of the mesh file to save
cout << "Mesh name: " << meshName << endl;


// --- Declare mesh variable ---
mesh Th;


// --- Try yo read the mesh ---
try{
    // Attempt to read the mesh from the file
    Th = readmesh(home + "mesh/" + meshName); // Read the mesh from a file
    cout << "Mesh already generated." << endl;
}
catch(...){
// 
// ========== Generate mesh ==========
//
    cout << "     -----> Mesh file not found. Generating mesh..." << endl;
}

if(bPlotMesh) plot(Th, wait = true, cmm = "Mesh of the porous duct"); // Plot the mesh if bPlotMesh is true