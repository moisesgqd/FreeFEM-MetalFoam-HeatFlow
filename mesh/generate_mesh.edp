//////////////////////////////////////////////////////////////
// Mesh generator for a porous duct simulation
// File: generate_mesh.edp
// Description: Simulation of fluid flow in a porous duct
// Author: Moises Quintanilla
// Date: 25-06-2025
//////////////////////////////////////////////////////////////

// ===== Debugging Options =====
// Enable debugging options to track the simulation process

verbosity = false; // Set to true to enable detailed output
bool bPlotMesh = true;
bool bValidDist = false;
int i, j, k; // General counters for loops

// ===== Relative and absolute paths =====
// Define the home directory for the project
// This path should be adjusted based on the user's directory structure
string home = "E:/FreeFEM_projects/PhD_research/porous_duct/";
string meshDataFile = home + "data/mesh_data.txt"; // file containing mesh data
string channelFile = home + "data/channel_characteristics.txt"; // file containing channel characteristics

// ==========================================================
// Inputs
// ==========================================================

// ===== Read channel characteristics ======
ifstream ChannelData(channelFile);
string property;
real value;
real[string] properties;

for(i=0; i<3; i++){
    ChannelData >> property >> value;
    properties[property] = value;
}

real L = properties["L"];
real H = properties["H"];
real W = properties["W"];

real xi=L/H, coeff;

// ===== Read mesh data ======
ifstream meshData(meshDataFile);
int nx, ny;
string blank, distribution;

meshData >> blank >> nx;
meshData >> blank >> ny;
meshData >> blank >> distribution;


// ===== Mesh characteristics =====
bool bdim = true; // is the mesh semi-dimensional?

// ==========================================================
// Mesh Generation Section
// ==========================================================

// Declare mesh variable
// The mesh will be generated based on the specified distribution type
mesh Th;

// Generate the mesh based on the distribution type
// The user will be prompted to enter the distribution type until a valid one is provided
if(distribution == "linear"){
    // Linear distribution mesh generation
    if (bdim){
        coeff = 1.0; // Reset xi for semi-dimensional case
    }
    else{
        coeff = xi; // Coefficient for full-dimensional case
    }
    func xDist = coeff*x; // x-coordinate
    func yDist = y; // y-coordinate
    Th = square(nx, ny, [xDist,yDist], flags=2);
}
else if(distribution == "quad"){
    // Quadratic distribution mesh generation
    if (bdim){
        coeff = 1.0; // Reset xi for semi-dimensional case
    }
    else{
        coeff = xi; // Coefficient for full-dimensional case
    }
    func xDist = coeff*square(x); // x-coordinate
    func yDist = square(y); // y-coordinate
    Th = square(nx, ny, [xDist,yDist], flags=2);
}
else if(distribution == "trigo"){
    // Trigonometric distribution mesh generation
    if (bdim){
        coeff = 1.0; // Reset xi for semi-dimensional case
    }
    else{
        coeff = xi; // Coefficient for full-dimensional case
    }
    func xDist = coeff*(1-cos(pi*x)); // x-coordinate
    func yDist = (1-cos(pi*y)); // y-coordinate
    Th = square(nx, ny, [xDist,yDist], flags=2);
}
else{
    cout << "Invalid distribution type. Please choose 'linear', 'quad', or 'trigo'." << endl;
    exit(0);
}


// ===== Name the mesh file =====
string meshName = "mesh_" + nx + "x" + ny + "_" + L + "x" + H + "_" + distribution + ".msh"; // Name of the mesh file to save


try{
    // Try reading the mesh from the file
    Th = readmesh(home + "mesh/" + meshName); // Read the mesh from a file
    cout << "Mesh already generated." << endl;
}
catch(...){
    // If the mesh file is not found, generate it
    cout << "     -----> Mesh file not found. Generating mesh..." << endl;
    savemesh(Th, home + "mesh/" + meshName);
}

if(bPlotMesh) plot(Th, wait = true, cmm = "Mesh of the porous duct");
